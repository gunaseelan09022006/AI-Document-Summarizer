# Application Settings
PROJECT_NAME="AI Document Summarizer"
ENVIRONMENT="development"
SECRET_KEY="super-secret-key-change-in-production-ai-doc-summarizer"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is SQLite for easy local dev. To use PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/doc_summarizer"
DATABASE_URL="sqlite:///./sql_app.db"

# LLM Providers
# Supported providers: "gemini", "openai", "auto" (will pick whichever key is available)
LLM_PROVIDER="auto"

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Upload and Security Configuration
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]
UPLOAD_DIR="./uploads"

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=20

